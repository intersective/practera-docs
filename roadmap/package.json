{
  "name": "practera-roadmap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed:roadmap": "tsx scripts/seed-roadmap.ts",
    "seed:capabilities": "tsx scripts/seed-capabilities.ts",
    "seed:capabilities:file": "tsx scripts/seed-capabilities.ts --from-file",
    "sync": "tsx scripts/sync-all.ts",
    "export": "tsx scripts/export-data.ts",
    "import": "tsx scripts/import-data.ts",
    "publish:customer": "tsx scripts/publish-customer-roadmap.ts",
    "test": "tsx --test src/lib/customer-roadmap.test.ts",
    "open-next:build": "open-next build",
    "infra.init": "sst install",
    "infra.deploy": "sst deploy --stage $ENV",
    "infra.destroy": "sst remove --stage $ENV"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "openai": "^7.4.0",
    "pg": "^8.13.0",
    "recharts": "^3.10.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "drizzle-orm": "^0.45.2",
    "tailwindcss": "^3.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@opennextjs/aws": "^3.9.6",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "autoprefixer": "^10.4.23",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.5.6",
    "sst": "^3.17.10",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  }
}
